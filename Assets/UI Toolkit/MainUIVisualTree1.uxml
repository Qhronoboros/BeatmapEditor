<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainStyleSheet.uss?fileID=7433441132597879392&amp;guid=c890b54a43b042f48bae723b0f30e5c1&amp;type=3#MainStyleSheet"/>
    <ui:VisualElement name="Container" picking-mode="Ignore" style="flex-grow: 1; justify-content: flex-start; align-content: auto; align-items: auto; align-self: auto; -unity-text-align: upper-left; position: relative; flex-direction: column; flex-shrink: 1; flex-wrap: nowrap;">
        <ui:VisualElement name="TopUI" picking-mode="Ignore" style="flex-grow: 1; top: auto; bottom: auto; align-self: flex-start; align-items: flex-start; align-content: flex-start; justify-content: flex-start; flex-direction: row; position: relative; flex-wrap: nowrap; -unity-text-align: upper-left; right: auto; flex-basis: auto; height: auto;">
            <ui:Button text="Save&#10;Project&#10;" name="SaveProject" class="button" style="width: 256px; height: 128px; font-size: 36px; align-items: stretch; justify-content: flex-start; align-self: flex-start; align-content: flex-start; top: auto; flex-direction: column;"/>
            <ui:Button text="Load&#10;Project&#10;" name="LoadProject" class="button" style="width: 256px; height: 128px; font-size: 36px; align-items: stretch; justify-content: flex-start; align-self: flex-start; align-content: flex-start; top: auto;"/>
            <ui:Button text="Import&#10;JSON" name="ImportJSON" class="button" style="width: 256px; height: 128px; font-size: 36px; align-items: stretch; justify-content: flex-start; align-self: flex-start; align-content: flex-start; top: auto;"/>
            <ui:Button text="Export&#10;JSON&#10;" name="ExportJSON" class="button" style="width: 256px; height: 128px; font-size: 36px; align-items: stretch; justify-content: flex-start; align-self: flex-start; align-content: flex-start; top: auto;"/>
            <ui:Button text="Load&#10;Music" name="LoadMusic" class="button" style="width: 256px; height: 128px; font-size: 36px; align-items: stretch; justify-content: flex-start; align-self: flex-start; align-content: flex-start; top: auto;"/>
            <ui:Label text="" name="SongTitle" style="font-size: 36px; -unity-font-style: bold; flex-wrap: wrap; width: 32%; flex-direction: column; align-items: stretch; justify-content: flex-start; align-self: flex-start; align-content: flex-start; flex-basis: 600px; -unity-text-align: upper-left; white-space: normal;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="WaveformContainer" picking-mode="Ignore" style="flex-grow: 1; position: absolute; flex-direction: column; justify-content: center; top: initial; width: 100%; height: 100%; align-items: auto; align-content: auto; align-self: center; visibility: visible;">
        <ui:Image source="project://database/Assets/Shaders/WaveformRenderTexture.asset?fileID=8600000&amp;guid=a08fa20195646fd4c9dbcfcda6919b95&amp;type=2#WaveformRenderTexture" name="Waveform" tint-color="rgb(255, 255, 255)" scale-mode="StretchToFill" picking-mode="Ignore" style="justify-content: center; align-items: center; position: absolute; background-color: rgb(55, 55, 55); align-self: center; align-content: center; flex-direction: column; flex-wrap: nowrap; flex-basis: auto; top: auto; bottom: auto; background-position-x: left 0; background-position-y: top 0; -unity-background-scale-mode: stretch-to-fill; height: 50%; width: 100%;"/>
        <ui:Label text="TestLabel" style="position: absolute; font-size: 36px; color: rgb(255, 255, 255); -unity-text-align: middle-left; background-color: rgb(0, 130, 50); height: 5%; width: 10%;"/>
        <ui:Image style="position: absolute; width: 5%; height: 5%; justify-content: center; align-content: center; align-items: flex-start; align-self: flex-start; left: 25%; color: rgb(0, 0, 0); background-color: rgb(0, 130, 50);"/>
    </ui:VisualElement>
    <ui:VisualElement name="ScrollableWaveformContainer" picking-mode="Ignore" style="flex-grow: 1; position: absolute; flex-direction: column; justify-content: flex-end; top: initial; width: 100%; height: 100%; align-items: auto; align-content: auto; align-self: center; visibility: visible; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0;">
        <ui:VisualElement picking-mode="Ignore" name="VisualElement" style="flex-grow: 1; align-content: flex-end; justify-content: flex-end; position: absolute; align-self: center; align-items: center; flex-direction: column; width: 100%; height: 10%; margin-bottom: 0; padding-bottom: 0%; bottom: 2.5%; margin-right: 0; padding-right: 0%; padding-left: 0%;">
            <ui:Image source="project://database/Assets/Shaders/ScrollableWaveformRenderTexture.asset?fileID=8600000&amp;guid=fa75c7fa8b0aa924d829fd342e13dbde&amp;type=2#ScrollableWaveformRenderTexture" name="ScrollableWaveform" tint-color="rgb(255, 255, 255)" scale-mode="StretchToFill" picking-mode="Ignore" style="justify-content: flex-end; align-items: center; position: relative; background-color: rgb(64, 64, 64); align-self: center; align-content: flex-end; flex-direction: column; flex-wrap: nowrap; flex-basis: auto; top: auto; bottom: auto; background-position-x: left 0; background-position-y: top 0; -unity-background-scale-mode: stretch-to-fill; height: auto; width: 100%;"/>
            <ui:Button text="" name="Scroll" focusable="true" style="position: absolute; left: 5%; align-self: flex-start; align-content: center; justify-content: center; align-items: flex-start; width: 5%; height: 100%; background-color: rgba(28, 176, 255, 0.63); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
